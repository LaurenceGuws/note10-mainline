From a0d33b3e53965104a18f487d5707b0e69ea00f1d Mon Sep 17 00:00:00 2001
From: Laurence <lggousie46@gmail.com>
Date: Sat, 26 Sep 2026 11:27:06 +0200
Subject: [PATCH] arm64: bracket primary switch mmu enable

---
 arch/arm64/kernel/head.S         | 134 ++++++++++++++++++++++++++++++-
 arch/arm64/kernel/pi/map_range.c |  13 +++
 2 files changed, 144 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 763a0ef10..d9448add5 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -320,9 +320,6 @@ SYM_CODE_START(primary_entry)
 	b.lo	.Lnote10_post_cpu_setup_clean
 	dsb	sy
 	isb
-.Lnote10_post_cpu_setup_hold:
-	wfe
-	b	.Lnote10_post_cpu_setup_hold
 
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
@@ -664,8 +661,71 @@ SYM_FUNC_START(__enable_mmu)
 	msr	ttbr0_el1, x2			// load TTBR0
 	load_ttbr1 x1, x1, x3
 
+	/*
+	 * Fifth diagnostic boundary, stage 1: TTBR0/TTBR1 setup completed.
+	 * Paint rows 672..703 yellow before the actual SCTLR/MMU transition.
+	 */
+	movz	x9, #0xca3b, lsl #16
+	movk	x9, #0x1000
+	mov	x10, x9
+	movz	x11, #0xff00
+	movk	x11, #0xffff, lsl #16
+	movk	x11, #0xff00, lsl #32
+	movk	x11, #0xffff, lsl #48		// two ARGB8888 yellow pixels
+	movz	x12, #0x0002, lsl #16
+	movk	x12, #0xd000
+	add	x12, x9, x12
+.Lnote10_pre_mmu_fill:
+	stp	x11, x11, [x10], #16
+	cmp	x10, x12
+	b.lo	.Lnote10_pre_mmu_fill
+
+	raw_dcache_line_size x13, x14
+	movz	x10, #0xca3b, lsl #16
+	movk	x10, #0x1000
+	sub	x14, x13, #1
+	bic	x10, x10, x14
+.Lnote10_pre_mmu_clean:
+	dc	cvac, x10
+	add	x10, x10, x13
+	cmp	x10, x12
+	b.lo	.Lnote10_pre_mmu_clean
+	dsb	sy
+	isb
+
 	set_sctlr_el1	x0
 
+	/*
+	 * Fifth diagnostic boundary, stage 2: the complete set_sctlr_el1
+	 * sequence returned with the MMU enabled. Paint the same band red via
+	 * the diagnostic TTBR0 framebuffer identity mapping.
+	 */
+	movz	x9, #0xca3b, lsl #16
+	movk	x9, #0x1000
+	mov	x10, x9
+	movz	x11, #0xffff, lsl #16
+	movk	x11, #0xffff, lsl #48		// two ARGB8888 red pixels
+	movz	x12, #0x0002, lsl #16
+	movk	x12, #0xd000
+	add	x12, x9, x12
+.Lnote10_post_mmu_fill:
+	stp	x11, x11, [x10], #16
+	cmp	x10, x12
+	b.lo	.Lnote10_post_mmu_fill
+
+	raw_dcache_line_size x13, x14
+	movz	x10, #0xca3b, lsl #16
+	movk	x10, #0x1000
+	sub	x14, x13, #1
+	bic	x10, x10, x14
+.Lnote10_post_mmu_clean:
+	dc	cvac, x10
+	add	x10, x10, x13
+	cmp	x10, x12
+	b.lo	.Lnote10_post_mmu_clean
+	dsb	sy
+	isb
+
 	ret
 SYM_FUNC_END(__enable_mmu)
 
@@ -703,10 +763,78 @@ SYM_FUNC_START_LOCAL(__no_granule_support)
 SYM_FUNC_END(__no_granule_support)
 
 SYM_FUNC_START_LOCAL(__primary_switch)
+	/*
+	 * Fifth diagnostic boundary, stage 0: prove entry into __primary_switch
+	 * while the MMU is still off by painting rows 672..703 blue.
+	 */
+	movz	x9, #0xca3b, lsl #16
+	movk	x9, #0x1000
+	mov	x10, x9
+	movz	x11, #0x00ff
+	movk	x11, #0xff00, lsl #16
+	movk	x11, #0x00ff, lsl #32
+	movk	x11, #0xff00, lsl #48		// two ARGB8888 blue pixels
+	movz	x12, #0x0002, lsl #16
+	movk	x12, #0xd000
+	add	x12, x9, x12
+.Lnote10_primary_switch_fill:
+	stp	x11, x11, [x10], #16
+	cmp	x10, x12
+	b.lo	.Lnote10_primary_switch_fill
+
+	raw_dcache_line_size x13, x14
+	movz	x10, #0xca3b, lsl #16
+	movk	x10, #0x1000
+	sub	x14, x13, #1
+	bic	x10, x10, x14
+.Lnote10_primary_switch_clean:
+	dc	cvac, x10
+	add	x10, x10, x13
+	cmp	x10, x12
+	b.lo	.Lnote10_primary_switch_clean
+	dsb	sy
+	isb
+
 	adrp	x1, reserved_pg_dir
 	adrp	x2, __pi_init_idmap_pg_dir
 	bl	__enable_mmu
 
+	/*
+	 * Fifth diagnostic boundary, stage 3: __enable_mmu returned to
+	 * __primary_switch with the MMU enabled. Paint rows 672..703 orange,
+	 * then hold before stack reset and __pi_early_map_kernel.
+	 */
+	movz	x9, #0xca3b, lsl #16
+	movk	x9, #0x1000
+	mov	x10, x9
+	movz	x11, #0x8000
+	movk	x11, #0xffff, lsl #16
+	movk	x11, #0x8000, lsl #32
+	movk	x11, #0xffff, lsl #48		// two ARGB8888 orange pixels
+	movz	x12, #0x0002, lsl #16
+	movk	x12, #0xd000
+	add	x12, x9, x12
+.Lnote10_post_enable_return_fill:
+	stp	x11, x11, [x10], #16
+	cmp	x10, x12
+	b.lo	.Lnote10_post_enable_return_fill
+
+	raw_dcache_line_size x13, x14
+	movz	x10, #0xca3b, lsl #16
+	movk	x10, #0x1000
+	sub	x14, x13, #1
+	bic	x10, x10, x14
+.Lnote10_post_enable_return_clean:
+	dc	cvac, x10
+	add	x10, x10, x13
+	cmp	x10, x12
+	b.lo	.Lnote10_post_enable_return_clean
+	dsb	sy
+	isb
+.Lnote10_post_enable_return_hold:
+	wfe
+	b	.Lnote10_post_enable_return_hold
+
 	adrp	x1, early_init_stack
 	mov	sp, x1
 	mov	x29, xzr
diff --git a/arch/arm64/kernel/pi/map_range.c b/arch/arm64/kernel/pi/map_range.c
index 761b14893..5b0e88851 100644
--- a/arch/arm64/kernel/pi/map_range.c
+++ b/arch/arm64/kernel/pi/map_range.c
@@ -90,12 +90,15 @@ void __init map_range(phys_addr_t *pte, u64 start, u64 end, phys_addr_t pa,
 
 asmlinkage phys_addr_t __init create_init_idmap(pgd_t *pg_dir, ptval_t clrmask)
 {
+	const phys_addr_t note10_diag_fb = 0xca200000;
 	phys_addr_t ptep = (phys_addr_t)pg_dir + PAGE_SIZE; /* MMU is off */
 	pgprot_t text_prot = PAGE_KERNEL_ROX;
 	pgprot_t data_prot = PAGE_KERNEL;
+	pgprot_t fb_prot = __pgprot(PROT_NORMAL_NC);
 
 	pgprot_val(text_prot) &= ~clrmask;
 	pgprot_val(data_prot) &= ~clrmask;
+	pgprot_val(fb_prot) &= ~clrmask;
 
 	/* MMU is off; pointer casts to phys_addr_t are safe */
 	map_range(&ptep, (u64)_stext, (u64)__initdata_begin,
@@ -105,5 +108,15 @@ asmlinkage phys_addr_t __init create_init_idmap(pgd_t *pg_dir, ptval_t clrmask)
 		  (phys_addr_t)__initdata_begin, data_prot, IDMAP_ROOT_LEVEL,
 		  (pte_t *)pg_dir, false, 0);
 
+	/*
+	 * Note10 bring-up diagnostic only: keep one framebuffer PMD block
+	 * identity-mapped across the first MMU enable so the existing visible
+	 * breadcrumb can prove the transition without changing the DT no-map
+	 * contract or the normal kernel mappings.
+	 */
+	map_range(&ptep, note10_diag_fb, note10_diag_fb + SZ_2M,
+		  note10_diag_fb, fb_prot, IDMAP_ROOT_LEVEL,
+		  (pte_t *)pg_dir, false, 0);
+
 	return ptep;
 }
-- 
2.55.0

