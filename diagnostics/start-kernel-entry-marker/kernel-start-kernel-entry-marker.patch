From d7d536f0f2449d805f3b232720a2e2e36a412b6b Mon Sep 17 00:00:00 2001
From: Laurence <lggousie46@gmail.com>
Date: Sat, 26 Sep 2026 14:06:58 +0200
Subject: [PATCH] arm64: mark start kernel entry

---
 arch/arm64/kernel/head.S |  3 ---
 init/main.c              | 44 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index d8b8b1d3d..5a0814a6f 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -566,9 +566,6 @@ SYM_FUNC_START_LOCAL(__primary_switched)
 	b.lo	.Lnote10_pre_start_kernel_clean
 	dsb	sy
 	isb
-.Lnote10_pre_start_kernel_hold:
-	wfe
-	b	.Lnote10_pre_start_kernel_hold
 
 	bl	start_kernel
 	ASM_BUG()
diff --git a/init/main.c b/init/main.c
index 3597d9b49..22bcd8e77 100644
--- a/init/main.c
+++ b/init/main.c
@@ -974,6 +974,50 @@ void start_kernel(void)
 	char *command_line;
 	char *after_dashes;
 
+#ifdef CONFIG_ARM64
+	/*
+	 * Note10 bring-up diagnostic: prove actual start_kernel entry after
+	 * the compiler-generated arm64/SCS prologue, before any ordinary
+	 * start_kernel source operation. Reuse the accepted transient TTBR0
+	 * framebuffer mapping and hold immediately after the visible marker.
+	 */
+	asm volatile("movz x9, #0xca3b, lsl #16\n\t"
+		"movk x9, #0x1000\n\t"
+		"mov x10, x9\n\t"
+		"movz x11, #0x4080\n\t"
+		"movk x11, #0xffff, lsl #16\n\t"
+		"movk x11, #0x4080, lsl #32\n\t"
+		"movk x11, #0xffff, lsl #48\n\t"
+		"movz x12, #0x0002, lsl #16\n\t"
+		"movk x12, #0xd000\n\t"
+		"add x12, x9, x12\n\t"
+		"1:\n\t"
+		"stp x11, x11, [x10], #16\n\t"
+		"cmp x10, x12\n\t"
+		"b.lo 1b\n\t"
+		"mrs x14, CTR_EL0\n\t"
+		"ubfx x14, x14, #16, #4\n\t"
+		"mov x13, #4\n\t"
+		"lsl x13, x13, x14\n\t"
+		"movz x10, #0xca3b, lsl #16\n\t"
+		"movk x10, #0x1000\n\t"
+		"sub x14, x13, #1\n\t"
+		"bic x10, x10, x14\n\t"
+		"2:\n\t"
+		"dc cvac, x10\n\t"
+		"add x10, x10, x13\n\t"
+		"cmp x10, x12\n\t"
+		"b.lo 2b\n\t"
+		"dsb sy\n\t"
+		"isb\n\t"
+		"3:\n\t"
+		"wfe\n\t"
+		"b 3b\n\t"
+		:
+		:
+		: "x9", "x10", "x11", "x12", "x13", "x14", "cc", "memory");
+#endif
+
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
 	debug_objects_early_init();
-- 
2.55.0

